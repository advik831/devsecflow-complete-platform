# =====================================================
# GitLab Runner Kubernetes Deployment Configuration
# =====================================================

# =====================================================
# Kubernetes Configuration
# =====================================================
NAMESPACE=gitlab-runner

# =====================================================
# Private Docker Registry Configuration
# =====================================================
REGISTRY_HOST=registry.example.com
REGISTRY_USER=admin
REGISTRY_PASSWORD=changeme
# Optional: Path to CA certificate for self-signed registries
CA_CERT_FILE=

# =====================================================
# Helm Configuration
# =====================================================
HELM_RELEASE=gitlab-runner
HELM_CHART_VERSION=0.60.0
HELM_REPO_URL=https://charts.gitlab.io

# =====================================================
# GitLab Configuration
# =====================================================
GITLAB_URL=https://gitlab.example.com
RUNNER_REGISTRATION_TOKEN=your-registration-token-here
RUNNER_MAX_CONCURRENT=10
RUNNER_TAGS=docker,kubernetes,production
RUNNER_LOCKED=false
RUNNER_RUN_UNTAGGED=true
RUNNER_PRIVILEGED=true
RUNNER_DEFAULT_IMAGE=alpine:latest
RUNNER_IMAGE_PULL_SECRETS=registry-credentials

# =====================================================
# Azure Blob Cache Configuration
# =====================================================
AZURE_ACCOUNT_NAME=mystorageaccount
AZURE_CONTAINER_NAME=gitlab-runner-cache
AZURE_STORAGE_DOMAIN=blob.core.windows.net
AZURE_USE_ACCOUNT_KEY=true
AZURE_ACCOUNT_KEY=your-azure-account-key-here
# Alternative: Use SAS Token instead of Account Key
# AZURE_USE_ACCOUNT_KEY=false
# AZURE_SAS_TOKEN=your-sas-token-here

# =====================================================
# Proxy Configuration (Optional)
# =====================================================
USE_PROXY=false
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=https://proxy.example.com:8443
NO_PROXY=localhost,127.0.0.1,.example.com,.svc,.cluster.local

# =====================================================
# Image Mirroring Configuration
# =====================================================
# Images to mirror from public registries to private registry
# Format: source_image:tag
IMAGES_TO_MIRROR=(
  "gitlab/gitlab-runner:alpine-v16.5.0"
  "gitlab/gitlab-runner-helper:x86_64-v16.5.0"
  "docker:24-dind"
  "alpine:latest"
  "busybox:latest"
)

# Destination registry path (will be combined with REGISTRY_HOST)
DEST_REGISTRY_PATH=gitlab

# Push latest tag in addition to specific version
PUSH_LATEST=true

# =====================================================
# Runner Resource Configuration
# =====================================================
RUNNER_CPU_REQUEST=100m
RUNNER_CPU_LIMIT=1000m
RUNNER_MEMORY_REQUEST=128Mi
RUNNER_MEMORY_LIMIT=512Mi

# =====================================================
# Runner Build Configuration
# =====================================================
BUILD_CPU_REQUEST=500m
BUILD_CPU_LIMIT=2000m
BUILD_MEMORY_REQUEST=512Mi
BUILD_MEMORY_LIMIT=4Gi

# =====================================================
# Security Configuration
# =====================================================
# Enable RBAC
RBAC_ENABLED=true
# Service account name
SERVICE_ACCOUNT_NAME=gitlab-runner
# Pod security context
RUN_AS_USER=999
FS_GROUP=999

# =====================================================
# Monitoring Configuration (Optional)
# =====================================================
ENABLE_METRICS=true
METRICS_PORT=9252

# =====================================================
# Advanced Configuration
# =====================================================
# Deployment mode: Deployment or StatefulSet
DEPLOYMENT_MODE=Deployment
# Number of runner replicas
RUNNER_REPLICAS=1
# Runner check interval
CHECK_INTERVAL=30
# Runner log level: debug, info, warn, error, fatal, panic
LOG_LEVEL=info
# Log format: runner, text, json
LOG_FORMAT=runner

# =====================================================
# DevSecOps Configuration
# =====================================================
# Enable pod security policies
ENABLE_POD_SECURITY_POLICY=false
# Network policy enabled
ENABLE_NETWORK_POLICY=false
# Image pull policy: Always, IfNotPresent, Never
IMAGE_PULL_POLICY=IfNotPresent

# =====================================================
# Script Behavior Configuration
# =====================================================
# Dry run mode (don't actually deploy)
DRY_RUN=false
# Debug mode (verbose logging)
DEBUG=false
# Skip image mirroring step
SKIP_IMAGE_MIRROR=false
# Skip prerequisites check
SKIP_PREREQ_CHECK=false
# Custom values file path (optional)
CUSTOM_VALUES_FILE=
